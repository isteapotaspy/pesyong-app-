<Window x:Class="PESYONG.Presentation.Admin.MainAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PESYONG.Presentation.Admin"
        mc:Ignorable="d"
        Title="MainAdminWindow" 
        Loaded="MainAdminWindow_Loaded"
        Height="450" 
        Width="800"
        MinWidth="800"
        MaxWidth="800">

    <Window.Resources>
        <!-- MenuItem Style with Bottom Highlight -->
        <Style x:Key="HighlightedMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="15,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ContentPresenter Content="{TemplateBinding Header}" 
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                <!-- Highlight indicator -->
                                <Rectangle x:Name="highlightIndicator" 
                                         Grid.Row="1" 
                                         Height="3" 
                                         Fill="White"
                                         Visibility="Collapsed"
                                         Margin="5,2,5,0"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB400"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF8C00"/>
                            </Trigger>

                            <!-- Show highlight for current selection -->
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="highlightIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" 
              FontSize="12">
            <MenuItem Header="_1 File" 
                      Background="Transparent"
                      InputGestureText="1">
                <MenuItem Header="_Refresh" InputGestureText="R"/>
                <MenuItem Header="E_xit" InputGestureText="E"/>
            </MenuItem>
            
            <MenuItem Header="_2 View" InputGestureText="2">
                <MenuItem Header="_Dashboard" InputGestureText="D" Click="DashboardMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_Meals" InputGestureText="M" Click="MealsMenuItem_Click"/>
                <MenuItem Header="_Packs" InputGestureText="P" Click="PacksMenuItem_Click"/>
                <MenuItem Header="_Orders" InputGestureText="O" Click="OrdersMenuItem_Click"/>
                <MenuItem Header="R_eceipts" InputGestureText="E" Click="ReceiptsMenuItem_Click"/>
                <MenuItem Header="_Delivery" InputGestureText="D" Click="DeliveriesMenuItem_Click"/>
                <MenuItem Header="_Customers" InputGestureText="C"/>
            </MenuItem>
            <MenuItem Header="_3 Quick Actions" InputGestureText="3">
                <MenuItem Header="Print Receipt" />
                <MenuItem Header="Manage Customer" />
                <Separator/>
                <MenuItem Header="Process Order" />
                <MenuItem Header="Update Order" />
            </MenuItem>
            <MenuItem Header="_4 Reports" InputGestureText="4">
                <MenuItem Header="Sales Report" />
                <MenuItem Header="Inventory Report" />
            </MenuItem>
            <MenuItem Header="_5 Settings" InputGestureText="5">
                <MenuItem Header="User Management" />
                <MenuItem Header="System Preferences" />
            </MenuItem>
        </Menu>

        <Frame x:Name="MainAdminFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
