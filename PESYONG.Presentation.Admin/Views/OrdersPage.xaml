<Page x:Class="PESYONG.Presentation.Admin.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PESYONG.Presentation.Admin.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Page.Resources>
        <!-- Destructive Button Style -->
        <Style x:Key="DestructiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Margin" Value="12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="DarkRed"
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkColor}}">
        <ScrollViewer Margin="262,-2,0,2" Width="536">
            <Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               HorizontalAlignment="Left" 
                               Margin="12,12,0,0"
                               Text="Order Details" 
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right" 
                                Margin="0,12,12,0">

                        <Button Content="New" 
                                        Style="{DynamicResource AccentButtonStyle}"/>
                        <Button Content="Edit" 
                                        Margin="12,0,0,0"/>
                        <Button Content="  Delete  " 
                                        Margin="12,0,24,0"
                                        Style="{StaticResource DestructiveButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <GroupBox>
                    <TextBlock></TextBlock>
                </GroupBox>
            </Grid>
        </ScrollViewer>
        <StackPanel HorizontalAlignment="Left" Width="240" Margin="12,12,0,12">
            <ListView Height="425" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
