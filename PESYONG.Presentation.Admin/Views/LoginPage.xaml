<Page x:Class="PESYONG.Presentation.Admin.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PESYONG.Presentation.Admin.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Grid Background="{DynamicResource {x:Static SystemColors.ControlDarkColor}}"
              HorizontalAlignment="Left" Width="800">
            <GroupBox Header="PESYONG Admin Login" Margin="360,12,36,0">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Left" 
                               Margin="12,12,0,0" 
                               TextWrapping="Wrap" 
                               Text="Username"
                               Foreground="White"/>
                    <TextBox HorizontalAlignment="Stretch" 
                             Margin="12,0,12,0"
                             TextWrapping="Wrap" />

                    <TextBlock HorizontalAlignment="Left" 
                               Margin="12,12,0,0" 
                               TextWrapping="Wrap" 
                               Text="Password"
                               Foreground="White"/>
                    <PasswordBox HorizontalAlignment="Stretch" Margin="12,0,12,0" PasswordChar="*"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,12,12,0">

                        <Button Content="Login" 
                                Margin="0,0,12,0"
                                Style="{DynamicResource AccentButtonStyle}" 
                                Click="LoginButton_Click"/>
                        <Button Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Page>
