    <NavigationView x:Name="AdminLayoutNavView" 
                    Grid.Row="0" 
                    Height="Auto"
                    IsPaneOpen="False"
                    PaneDisplayMode="Auto"
                    IsTabStop="False"
                    ItemInvoked="NavigationViewItem_Invoked">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" 
                                Icon="Home" ToolTipService.ToolTip="Dashboard" 
                                Tag="PESYONG.Presentation.Views.Admin.DashboardPage"/>
            
            <NavigationViewItem Content="Meals" ToolTipService.ToolTip="Meals">
                <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Kiosk Meals" 
                                        ToolTipService.ToolTip="Individual Meals" 
                                        Tag="PESYONG.Presentation.Views.Admin.Meals.MealPage">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xED56;" FontFamily="Segoe MDL2 Assets" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Catering Packages" 
                                        ToolTipService.ToolTip="Meal Packages" 
                                        Tag="PESYONG.Presentation.Views.Admin.Meals.MealPackagePage">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe MDL2 Assets" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
            </NavigationViewItem>
            
            <NavigationViewItem Content="Logistics" ToolTipService.ToolTip="Logistics" SelectsOnInvoked="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Delivery" 
                                        Icon="OpenLocal" 
                                        ToolTipService.ToolTip="Deliveries" 
                                        Tag="PESYONG.Presentation.Views.Admin.Logistics.DeliveryPage"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <NavigationViewItem Content="Transactions" ToolTipService.ToolTip="Document options" SelectsOnInvoked="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Orders" 
                                        Icon="Shop" 
                                        ToolTipService.ToolTip="Upload file" 
                                        Tag="PESYONG.Presentation.Views.Admin.Transactions.Orderpage"/>
                    <NavigationViewItem Content="Payments" 
                                    ToolTipService.ToolTip="Create new" 
                                    Tag="PESYONG.Presentation.Views.Admin.Transactions.AcknowledgementReceipt">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    
                    <NavigationViewItem Content="Acknowledgement Receipts" 
                                    Icon="Document" 
                                    ToolTipService.ToolTip="Create new" 
                                    Tag="PESYONG.Presentation.Views.Admin.Transactions.AcknowledgementReceipt"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <NavigationViewItem Content="Administration" ToolTipService.ToolTip="Document options" SelectsOnInvoked="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Customers" 
                                        Icon="Contact" 
                                        ToolTipService.ToolTip="Upload file" 
                                        Tag="PESYONG.Presentation.Views.Admin.Administration.CustomerPage"/>
                    <NavigationViewItem Content="App Users" 
                                        Icon="Account" 
                                        ToolTipService.ToolTip="Accounts" 
                                        Tag="PESYONG.Presentation.Views.Admin.Administration.AppUserPage"/>
                    <NavigationViewItem Content="System Logs" 
                                        Icon="List" 
                                        ToolTipService.ToolTip="Create new" 
                                        Tag="PESYONG.Presentation.Views.Admin.Administration.AuditLogPage"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox QueryIcon="Find" AutomationProperties.Name="Search" />
        </NavigationView.AutoSuggestBox>

        <Frame x:Name="MainContentFrame" 
               Grid.Column="1"               
               VerticalAlignment="Stretch"/>
        </NavigationView>
    </Grid>
</UserControl>
