<UserControl
    x:Class="PESYONG.Presentation.Components.Layouts.CustomerLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Color x:Key="CustomOrange">#FF6600</Color>
        <Color x:Key="CustomOrangeLight">#FF8533</Color>
        <Color x:Key="CustomOrangeDark">#CC5200</Color>

        <!-- Selected -->
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource CustomOrange}"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="DarkBlue"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedTop" Color="DarkBlue"/>
        <SolidColorBrush x:Key="NavigationViewItemIconSelectedForeground" Color="DarkBlue"/>

        <!-- Hover -->
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource CustomOrangeLight}"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="DarkBlue"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOverTop" Color="{StaticResource CustomOrangeLight}"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverTop" Color="DarkBlue"/>
        <SolidColorBrush x:Key="NavigationViewItemIconPointerOverForeground" Color="DarkBlue"/>
        <SolidColorBrush x:Key="NavigationViewItemIconPointerOverForegroundTop" Color="DarkBlue"/>

        <!-- Pressed -->
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{StaticResource CustomOrangeDark}"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="DarkRed"/>

        <!-- Default -->
        <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#333333"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundTop" Color="#333333"/>
        <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#666666"/>

        <!-- Indicator / Pane -->
        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="DarkBlue"/>
        <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="LightBlue"/>
        <SolidColorBrush x:Key="NavigationViewTopPaneBorderBrush" Color="LightBlue"/>
    </UserControl.Resources>

    <Grid Background="#FFFDF5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FF6600" Padding="16,10">
            <Grid x:Name="HeaderGrid">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="WideState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1000"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SearchBox.Width" Value="420"/>
                                <Setter Target="HeaderActionsPanel.Orientation" Value="Horizontal"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="MediumState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="700"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SearchBox.Width" Value="280"/>
                                <Setter Target="HeaderActionsPanel.Orientation" Value="Horizontal"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="NarrowState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SearchBox.Width" Value="180"/>
                                <Setter Target="HeaderActionsPanel.Orientation" Value="Horizontal"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/peshong.png"
                           Width="40"
                           Height="40"
                           Margin="0,0,10,0"
                           Stretch="Uniform"/>
                    <StackPanel>
                        <TextBlock Text="PESYONG"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Catering App"
                                   FontSize="12"
                                   Foreground="White"
                                   Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="1"
                                Height="35"
                                MaxWidth="420"
                                PlaceholderText="Search for dishes, orders..."
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                QueryIcon="Find"/>

                <!-- Header actions -->
                <StackPanel x:Name="HeaderActionsPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">

                    <Button Background="Transparent"
        BorderThickness="0"
        Padding="8,6"
        Click="CartButton_Click">
                        <Grid MinWidth="88">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                                <SymbolIcon Symbol="Shop" Foreground="White"/>
                                <TextBlock Text="My Cart" Foreground="White"/>
                            </StackPanel>

                            <Border x:Name="HeaderCartBadge"
                Grid.Column="1"
                Background="White"
                CornerRadius="999"
                MinWidth="20"
                Height="20"
                Padding="5,0"
                Margin="4,0,0,10"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Visibility="Collapsed">
                                <TextBlock x:Name="HeaderCartBadgeText"
                       Foreground="#FF6600"
                       FontSize="10"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            Click="OrderHistoryButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <SymbolIcon Symbol="MapDrive" Foreground="White"/>
                            <TextBlock Text="Orders" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            Click="HelpButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <SymbolIcon Symbol="Help" Foreground="White"/>
                            <TextBlock Text="Help" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NAVIGATION -->
        <NavigationView Grid.Row="1"
                        x:Name="MainNavigationView"
                        PaneDisplayMode="Top"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="MainNavigationView_SelectionChanged"
                        Background="White">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CateringPackagesNavItem"
                                    Content="Catering Packages"
                                    Tag="CateringPackagesPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ShortOrdersNavItem"
                                    Content="Short Orders"
                                    Tag="ShortOrdersPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA37;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="KakaninNavItem"
                                    Content="Kakanin"
                                    Tag="KakaninPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEE94;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="MainNavigationViewFrame"/>
        </NavigationView>
    </Grid>
</UserControl>