<Page
    x:Class="PESYONG.Presentation.Views.Customer.OrderHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:PESYONG.Presentation.Converters"
    mc:Ignorable="d"
    Background="#FFFDF5">

    <Page.Resources>
        <local:PriceFormatConverter x:Key="PriceFormatConverter"/>
        <local:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
        <local:OrderStatusToColorConverter x:Key="OrderStatusToColorConverter"/>
        <local:OrderStatusToTextConverter x:Key="OrderStatusToTextConverter"/>
        <local:OrderStatusToIconConverter x:Key="OrderStatusToIconConverter"/>
        <local:OrderStatusToVisibilityConverter x:Key="OrderStatusToVisibilityConverter"/>
        <local:OrderStatusToReorderConverter x:Key="OrderStatusToReorderConverter"/>

        <Style x:Key="OrderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFDFC"/>
            <Setter Property="BorderBrush" Value="#F2C999"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="InnerSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF7EE"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <Style x:Key="ProgressStepStyle" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#FF6A00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Background" Value="#E85F00"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Background" Value="#CC5400"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Background" Value="#F3F3F3"/>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.6"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F2C999"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#D85B00"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Background" Value="#FFF6EC"/>
                                            <Setter Target="ButtonBorder.BorderBrush" Value="#E8A45F"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Background" Value="#FDEAD8"/>
                                            <Setter Target="ButtonBorder.BorderBrush" Value="#D85B00"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Background" Value="#FAFAFA"/>
                                            <Setter Target="ButtonBorder.BorderBrush" Value="#E5E5E5"/>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.5"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FF6600"
                CornerRadius="18"
                Padding="22,16"
                Margin="20,20,20,0">
            <StackPanel Spacing="4">
                <TextBlock Text="Orders and Tracking"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="White"/>
                <TextBlock Text="Track your orders and view order history"
                                FontSize="15"
                                Foreground="#FFF2E8"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1"
                      Padding="20"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Empty State -->
                <Border x:Name="EmptyStatePanel"
                        Grid.Row="0"
                        Background="#FFFFF6EA"
                        BorderBrush="#FFF2D2A8"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel Spacing="18" MaxWidth="420">
                        <FontIcon Glyph="&#xE8C7;"
                                  FontSize="68"
                                  Foreground="#FFCC8A"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="No Orders Yet"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#FF6600"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Once you place an order, its status and details will appear here."
                                   FontSize="15"
                                   Foreground="#7A6A5C"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Orders List -->
                <ItemsControl x:Name="OrdersList" Grid.Row="0" Visibility="Visible">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource OrderCardStyle}">
                                <StackPanel Spacing="16">

                                    <!-- Top -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="Order #"
                                                            FontSize="14"
                                                            Foreground="#8A7768"
                                                            VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding OrderID}"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#C24B00"
                                                            VerticalAlignment="Center"/>

                                                <Border Style="{StaticResource StatusBadgeStyle}"
                                                        Background="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToColorConverter}}">
                                                    <TextBlock Text="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToTextConverter}}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="White"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Spacing="2">
                                                <TextBlock FontSize="14" Foreground="#5B4B3F">
                                    <Run Text="Order Date: "/>
                                    <Run Text="{Binding OrderDate, Converter={StaticResource DateTimeToStringConverter}}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="14" Foreground="#5B4B3F">
                                    <Run Text="Delivery Date: "/>
                                    <Run Text="{Binding ActualDeliveryDate, Converter={StaticResource DateTimeToStringConverter}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="Total"
                                       FontSize="13"
                                       Foreground="#8A7768"
                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding OrderTotalAmount, Converter={StaticResource PriceFormatConverter}}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#FF6600"
                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Items -->
                                    <Border Style="{StaticResource InnerSectionStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Items:"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#C85C00"/>

                                            <ItemsControl ItemsSource="{Binding OrderItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="•" Foreground="#C85C00"/>
                                                                <TextBlock Text="{Binding MealProductName}"
                                                                            FontSize="14"
                                                                            Foreground="#4D4035"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                                                        Text="{Binding MealProductOrderQty}"
                                                                        FontSize="14"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="#FF7A00"
                                                                        HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Progress -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Delivery Progress"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C85C00"/>

                                        <Grid Margin="0,4,0,0">
                                            <Border Height="3"
                                                    Margin="28,16,28,0"
                                                    Background="#F1D7B7"
                                                    CornerRadius="2"
                                                    VerticalAlignment="Top"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
                                                    <Border Style="{StaticResource ProgressStepStyle}"
                                                               Background="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToColorConverter}, ConverterParameter=0}">
                                                        <FontIcon Glyph="&#xE121;"
                                                                    FontSize="14"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Pending"
                                                                FontSize="12"
                                                                Foreground="#7A6A5C"
                                                                HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="6">
                                                    <Border Style="{StaticResource ProgressStepStyle}"
                                                            Background="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToColorConverter}, ConverterParameter=1}">
                                                        <FontIcon Glyph="&#xE7B8;"
                                                                    FontSize="14"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Preparing"
                                                                FontSize="12"
                                                                Foreground="#7A6A5C"
                                                                HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                                                    <Border Style="{StaticResource ProgressStepStyle}"
                                                            Background="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToColorConverter}, ConverterParameter=2}">
                                                        <FontIcon Glyph="&#xE804;"
                                                                    FontSize="14"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="On the way"
                                                                FontSize="12"
                                                                Foreground="#7A6A5C"
                                                                HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="6">
                                                    <Border Style="{StaticResource ProgressStepStyle}"
                                                            Background="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToColorConverter}, ConverterParameter=3}">
                                                        <FontIcon Glyph="&#xE73E;"
                                                                    FontSize="14"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Delivered"
                                                                FontSize="12"
                                                                Foreground="#7A6A5C"
                                                                HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Buttons -->
                                    <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                IsEnabled="False">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7C4;" FontSize="16" Foreground="#D85B00"/>
                                                <TextBlock Text="Track Order"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Tag="{Binding}"
                                Click="ReviewButton_Click"
                                Visibility="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="White"/>
                                                <TextBlock Text="Leave a Review"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                IsEnabled="{Binding DeliveryStatus, Converter={StaticResource OrderStatusToReorderConverter}}"
                                Tag="{Binding}"
                                Click="ReorderButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#D85B00"/>
                                                <TextBlock Text="Reorder"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Help Card -->
                <Border Grid.Row="1"
                        Background="#FFFFF6EA"
                        BorderBrush="#FFF2D2A8"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20"
                        Margin="0,20,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Need Help?"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FF6600"/>
                        <TextBlock Text="Questions about your order? Reach out to us anytime."
                                   Foreground="#7A6A5C"
                                   FontSize="14"/>
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#CC6A00">
                                <Run Text="📞 Phone: "/>
                                <Run Text="(123) 456-7890"/>
                            </TextBlock>
                            <TextBlock Foreground="#CC6A00">
                                <Run Text="📧 Email: "/>
                                <Run Text="support@orangecatering.com"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Review Dialog -->
        <ContentDialog x:Name="ReviewDialog"
                       Title="Leave a Review"
                       PrimaryButtonText="Submit Review"
                       CloseButtonText="Cancel"
                       PrimaryButtonClick="ReviewDialog_PrimaryButtonClick"
                       DefaultButton="Primary">
            <ContentDialog.Content>
                <StackPanel Width="420" Spacing="18">
                    <TextBlock x:Name="ReviewDialogTitle"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FF6600"
                               TextWrapping="Wrap"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Rating"
                                   Foreground="#CC6A00"
                                   FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Button x:Name="Star1" Click="StarRating_Click" Tag="1" Background="Transparent">
                                <FontIcon x:Name="Star1Icon" Glyph="&#xE734;" FontSize="32" Foreground="#FFB266"/>
                            </Button>
                            <Button x:Name="Star2" Click="StarRating_Click" Tag="2" Background="Transparent">
                                <FontIcon x:Name="Star2Icon" Glyph="&#xE734;" FontSize="32" Foreground="#FFB266"/>
                            </Button>
                            <Button x:Name="Star3" Click="StarRating_Click" Tag="3" Background="Transparent">
                                <FontIcon x:Name="Star3Icon" Glyph="&#xE734;" FontSize="32" Foreground="#FFB266"/>
                            </Button>
                            <Button x:Name="Star4" Click="StarRating_Click" Tag="4" Background="Transparent">
                                <FontIcon x:Name="Star4Icon" Glyph="&#xE734;" FontSize="32" Foreground="#FFB266"/>
                            </Button>
                            <Button x:Name="Star5" Click="StarRating_Click" Tag="5" Background="Transparent">
                                <FontIcon x:Name="Star5Icon" Glyph="&#xE734;" FontSize="32" Foreground="#FFB266"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Your Review"
                                   Foreground="#CC6A00"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="ReviewTextBox"
                                 PlaceholderText="Share your experience with this item..."
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="120"/>
                    </StackPanel>

                    <TextBlock x:Name="ReviewStatusText"
                               Foreground="#8A7768"
                               FontSize="12"/>
                </StackPanel>
            </ContentDialog.Content>
        </ContentDialog>
    </Grid>
</Page>