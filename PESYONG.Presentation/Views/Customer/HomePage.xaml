<Page
    x:Class="PESYONG.Presentation.Views.Customer.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PESYONG.Presentation.Views.Customer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="24" Background="LightBlue">
            <!-- Hero Section -->
            <Border CornerRadius="15" Padding="0">
                <Border Background="#FF6600" CornerRadius="15" Padding="40">
                    <StackPanel MaxWidth="600" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="★" FontSize="20" Foreground="#FFD700" />
                            <Border Background="#FFD700" CornerRadius="20" Padding="12,4">
                                <TextBlock Text="Premium Quality" Foreground="#FF6600" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Welcome to PESYONG!" FontSize="42" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Authentic Filipino flavors delivered to your doorstep. Fresh, delicious, and perfect for any occasion."
                                   FontSize="18" Foreground="White" Opacity="0.9" TextWrapping="Wrap"/>

                        <Button Background="White"
                                Foreground="#FF6600"
                                CornerRadius="20"
                                Margin="0,20,0,0"
                                Padding="20,10"
                                FontWeight="Bold"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                Click="ViewPackagesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="View Packages" VerticalAlignment="Center"/>
                                <TextBlock Text="🛒" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Active Promos Section -->
            <StackPanel Spacing="12">
                <Border Background="#FFF9E6" CornerRadius="12" Padding="16" BorderBrush="#FFB266" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FF6600" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="🔔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Weekend Special" FontWeight="Bold" Foreground="#CC5200"/>
                                <Border Background="#4CAF50" CornerRadius="12" Padding="8,2">
                                    <TextBlock Text="Active" Foreground="White" FontSize="10"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="15% off on all catering packages" Foreground="#CC5200" FontSize="14"/>
                            <TextBlock Text="Valid until March 31, 2026" Foreground="#666666" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Feature Cards -->
            <Grid Margin="0,8,0,0">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="WideCardsState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1100"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="WideCardsGrid.Visibility" Value="Visible"/>
                                <Setter Target="MediumCardsGrid.Visibility" Value="Collapsed"/>
                                <Setter Target="NarrowCardsGrid.Visibility" Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="MediumCardsState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="700"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="WideCardsGrid.Visibility" Value="Collapsed"/>
                                <Setter Target="MediumCardsGrid.Visibility" Value="Visible"/>
                                <Setter Target="NarrowCardsGrid.Visibility" Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="NarrowCardsState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="WideCardsGrid.Visibility" Value="Collapsed"/>
                                <Setter Target="MediumCardsGrid.Visibility" Value="Collapsed"/>
                                <Setter Target="NarrowCardsGrid.Visibility" Value="Visible"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- WIDE: 3 columns -->
                <Grid x:Name="WideCardsGrid" ColumnSpacing="16" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FF6600" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="📦" FontSize="48"/>
                            <TextBlock Text="Catering Packages" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Perfect for events &amp; celebrations" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#FF6600"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreCateringButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#E65C00" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🍽️" FontSize="48"/>
                            <TextBlock Text="Short Orders" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Individual viands &amp; meals" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#CC5200"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreShortOrdersButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#CC5200" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🍚" FontSize="48"/>
                            <TextBlock Text="Kakanin" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Traditional Filipino treats" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#B34700"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreKakaninButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MEDIUM: 2 columns -->
                <Grid x:Name="MediumCardsGrid" ColumnSpacing="16" RowSpacing="16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#FF6600" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="📦" FontSize="48"/>
                            <TextBlock Text="Catering Packages" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Perfect for events &amp; celebrations" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#FF6600"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreCateringButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="#E65C00" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🍽️" FontSize="48"/>
                            <TextBlock Text="Short Orders" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Individual viands &amp; meals" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#CC5200"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreShortOrdersButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#CC5200" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🍚" FontSize="48"/>
                            <TextBlock Text="Kakanin" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Traditional Filipino treats" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#B34700"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreKakaninButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- NARROW: 1 column -->
                <StackPanel x:Name="NarrowCardsGrid" Spacing="16" Visibility="Collapsed">
                    <Border Background="#FF6600" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="📦" FontSize="48"/>
                            <TextBlock Text="Catering Packages" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Perfect for events &amp; celebrations" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#FF6600"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreCateringButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="#E65C00" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🍽️" FontSize="48"/>
                            <TextBlock Text="Short Orders" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Individual viands &amp; meals" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#CC5200"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreShortOrdersButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="#CC5200" CornerRadius="15" Padding="20" MinHeight="210">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🍚" FontSize="48"/>
                            <TextBlock Text="Kakanin" FontWeight="Bold" Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="Traditional Filipino treats" Foreground="#FFE6CC" FontSize="14" TextWrapping="Wrap"/>
                            <Button Background="White"
                        Foreground="#B34700"
                        CornerRadius="20"
                        Padding="12,6"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ExploreKakaninButton_Click">
                                <TextBlock Text="Explore →" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Info Cards -->
            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFF2E6" CornerRadius="15" Padding="24" BorderBrush="#FFB266" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🚚 Smart Delivery" FontWeight="Bold" Foreground="#CC5200" FontSize="20"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CC5200">
                            <Run FontWeight="Bold" Text="Poblacion:"/>
                            <Run Text=" ₱15 flat rate"/>
                            <LineBreak/>
                            <Run FontWeight="Bold" Text="Outside:"/>
                            <Run Text=" Starting at ₱25"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#FFF2E6" CornerRadius="15" Padding="24" BorderBrush="#FFB266" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💳 Payment Options" FontWeight="Bold" Foreground="#CC5200" FontSize="20"/>
                        <TextBlock Text="Cash on Delivery • GCash • Down Payment for Catering Events"
                                   TextWrapping="Wrap" Foreground="#CC5200"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>