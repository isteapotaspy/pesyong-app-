<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PESYONG.Presentation.Views.Admin.Transactions.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:objectmodels="using:PESYONG.Presentation.ViewModels.ObjectModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance objectmodels:OrderViewModel}">

    <Page.Resources>
        <DataTemplate x:Key="OrderListTemplate" x:DataType="objectmodels:OrderViewModel">
            <Border Padding="12,10" CornerRadius="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind DisplayName}"
                                   FontWeight="SemiBold"
                                   Style="{ThemeResource BaseTextBlockStyle}" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Right">
                            <Border Background="#303030"
                                    CornerRadius="12"
                                    Padding="8,3">
                                <TextBlock Text="{x:Bind DeliveryTypeDisplay}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Border Background="{x:Bind DeliveryStatusBadgeBrush}"
                                    CornerRadius="12"
                                    Padding="8,3">
                                <TextBlock Text="{x:Bind DeliveryStatusDisplay}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind FormattedOrderTotalAmount}"
                               Opacity="0.8"
                               Style="{ThemeResource BodyTextBlockStyle}" />

                    <TextBlock Grid.Row="2"
                               Text="{x:Bind Address}"
                               FontSize="12"
                               Opacity="0.65"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OrderItemTemplate" x:DataType="objectmodels:OrderMealProductViewModel">
            <Border Padding="8"
                    Margin="0,4,0,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{x:Bind MealProductName}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind FormattedItemPrice}" FontSize="12" Opacity="0.75"/>
                    </StackPanel>

                    <NumberBox Grid.Column="1"
                               Minimum="1"
                               Maximum="1000"
                               SmallChange="1"
                               SpinButtonPlacementMode="Inline"
                               ValidationMode="InvalidInputOverwritten"
                               Value="{x:Bind MealProductOrderQty, Mode=TwoWay}" />

                    <TextBox Grid.Column="2"
                             Text="{x:Bind ItemPrice, Mode=TwoWay}" />

                    <Button Grid.Column="3"
                            Content="Remove"
                            Click="RemoveOrderItemButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="OrdersListView"
                      Grid.Row="0"
                      Margin="0,0,0,12"
                      SelectionMode="Single"
                      ItemsSource="{x:Bind OrderListViewModels, Mode=OneWay}"
                      ItemTemplate="{StaticResource OrderListTemplate}"
                      SelectionChanged="OrdersListView_SelectionChanged"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="8"/>

            <Button Grid.Row="1"
                    Content="Add New Order"
                    Click="AddOrderButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Border Grid.Column="2"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <TextBlock Text="Order Configuration"
                               Style="{StaticResource TitleTextBlockStyle}" />

                    <Border Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Customer Details"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Row="0"
                                         Grid.Column="0"
                                         Header="First Name"
                                         Text="{Binding CustomerFirstName, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Header="Last Name"
                                         Text="{Binding CustomerLastName, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <TextBox Grid.Row="1"
                                         Grid.Column="0"
                                         Header="Phone Number"
                                         Text="{Binding CustomerPhoneNumber, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Header="Email"
                                         Text="{Binding CustomerEmail, Mode=OneWay}"
                                         IsReadOnly="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Header="Order ID"
                                 Text="{Binding OrderIDText}"
                                 IsReadOnly="True" />

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Header="Customer ID"
                                 Text="{Binding CustomerIDText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 Header="Receipt ID"
                                 Text="{Binding ReceiptIDText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />

                        <CalendarDatePicker Grid.Row="1"
                                            Grid.Column="1"
                                            Header="Order Date"
                                            Date="{Binding OrderDateUi, Mode=TwoWay}" />

                        <ComboBox Grid.Row="2"
                                  Grid.Column="0"
                                  Header="Delivery Type"
                                  ItemsSource="{x:Bind DeliveryTypes, Mode=OneWay}"
                                  SelectedItem="{Binding DeliveryType, Mode=TwoWay}"
                                  SelectionChanged="FormComboBox_SelectionChanged" />

                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Header="Delivery Status"
                                  ItemsSource="{x:Bind DeliveryStatuses, Mode=OneWay}"
                                  SelectedItem="{Binding DeliveryStatus, Mode=TwoWay}"
                                  SelectionChanged="FormComboBox_SelectionChanged" />

                        <TextBox Grid.Row="3"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Header="Address"
                                 Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CalendarDatePicker Grid.Row="0"
                                            Grid.Column="0"
                                            Header="Estimated Delivery Date"
                                            Date="{Binding EstimatedDeliveryDateUi, Mode=TwoWay}" />

                        <CalendarDatePicker Grid.Row="0"
                                            Grid.Column="1"
                                            Header="Actual Delivery Date"
                                            Date="{Binding ActualDeliveryDateUi, Mode=TwoWay}" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 Header="Tracking Number"
                                 Text="{Binding TrackingNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Header="Order Total"
                                 Text="{Binding FormattedOrderTotalAmount, Mode=OneWay}"
                                 IsReadOnly="True" />
                    </Grid>

                    <TextBox Header="Customer Notes"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90"
                             Text="{Binding CustomerNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="FormTextBox_TextChanged" />

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MealProductIdTextBox"
                                     Grid.Column="0"
                                     Header="Meal Product ID" />

                            <NumberBox x:Name="ItemQuantityNumberBox"
                                       Grid.Column="1"
                                       Header="Quantity"
                                       Minimum="1"
                                       Maximum="1000"
                                       Value="1"
                                       SpinButtonPlacementMode="Inline" />

                            <TextBox x:Name="ItemPriceTextBox"
                                     Grid.Column="2"
                                     Header="Item Price" />

                            <Button Grid.Column="3"
                                    Content="Add Item"
                                    VerticalAlignment="Bottom"
                                    Click="AddOrderItemButton_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Order Items"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding FormattedOrderTotalAmount}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <ListView x:Name="OrderItemsListView"
                                  ItemsSource="{Binding OrderItems}"
                                  ItemTemplate="{StaticResource OrderItemTemplate}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  MaxHeight="360" />
                    </StackPanel>

                    <TextBlock Text="{Binding ValidationSummary}"
                               Foreground="IndianRed"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="DarkSlateGray"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Delete"
                                Click="DeleteOrderButton_Click" />

                        <Button Content="Save Changes"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveOrderButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>