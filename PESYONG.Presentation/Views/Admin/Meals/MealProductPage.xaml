<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PESYONG.Presentation.Views.Admin.Meals.MealProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:objectmodels="using:PESYONG.Presentation.ViewModels.ObjectModels"
    xmlns:mealentities="using:PESYONG.Domain.Entities.Meals.MealItem"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance objectmodels:MealProductViewModel}">

    <Page.Resources>
        <DataTemplate x:Key="MealProductListTemplate" x:DataType="objectmodels:MealProductViewModel">
            <Grid Padding="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind ProductName}"
                           Style="{ThemeResource BaseTextBlockStyle}" />

                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Text="{x:Bind FormattedFinalPrice}"
                           Opacity="0.75"
                           Style="{ThemeResource BodyTextBlockStyle}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MealCatalogTemplate" x:DataType="mealentities:Meal">
            <StackPanel Padding="8,6">
                <TextBlock Text="{x:Bind MealName}" />
                <TextBlock Text="{x:Bind MealPrice, Mode=OneWay}"
                           FontSize="12"
                           Opacity="0.75" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MealItemTemplate" x:DataType="objectmodels:MealProductItemViewModel">
            <Border Padding="8"
                    Margin="0,4,0,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{x:Bind MealName}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind FormattedUnitPrice}" FontSize="12" Opacity="0.75"/>
                    </StackPanel>

                    <NumberBox Grid.Column="1"
                               Minimum="1"
                               Maximum="100"
                               SmallChange="1"
                               SpinButtonPlacementMode="Inline"
                               ValidationMode="InvalidInputOverwritten"
                               Value="{x:Bind Quantity, Mode=TwoWay}" />

                    <TextBox Grid.Column="2"
                             PlaceholderText="Special request"
                             Text="{x:Bind RequestDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="3"
                            Content="Remove"
                            Click="RemoveMealItemButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="MealProductsListView"
                      Grid.Row="0"
                      Margin="0,0,0,12"
                      SelectionMode="Single"
                      ItemsSource="{x:Bind MealProductListViewModels, Mode=OneWay}"
                      ItemTemplate="{StaticResource MealProductListTemplate}"
                      SelectionChanged="MealProductsListView_SelectionChanged"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="8"/>

            <Button Grid.Row="1"
                    Content="Add New Meal Product"
                    Click="AddMealProductButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- RIGHT -->
        <Border Grid.Column="2"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <TextBlock Text="Meal Product Configuration"
                               Style="{StaticResource TitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Header="Meal Product ID"
                                 Text="{Binding MealProductID}"
                                 IsReadOnly="True" />

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Header="Owner ID"
                                 Text="{Binding OwnerID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 Header="Promo ID"
                                 Text="{Binding PromoID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 TextChanged="FormTextBox_TextChanged" />

                        <CheckBox Grid.Row="1"
                                  Grid.Column="1"
                                  Content="Is Catering Package"
                                  IsChecked="{Binding IsCateringPackage, Mode=TwoWay}" />

                        <TextBox Grid.Row="2"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Header="Product Name"
                                 Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />

                        <TextBox Grid.Row="3"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Header="Product Description"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Text="{Binding ProductDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Available Meals"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="MealSelectorComboBox"
                                      Grid.Column="0"
                                      Header="Select Meal"
                                      ItemsSource="{Binding AvailableMeals}"
                                      SelectedItem="{Binding SelectedMealForAdd, Mode=TwoWay}"
                                      DisplayMemberPath="MealName" />

                            <Button Grid.Column="1"
                                    Content="Add Meal"
                                    VerticalAlignment="Bottom"
                                    Click="AddMealItemButton_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Included Meals"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Spacing="2">
                                <TextBlock Text="{Binding FormattedProductBasePrice}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FormattedDiscountAmount}"
                                           FontSize="12"
                                           Opacity="0.75" />
                                <TextBlock Text="{Binding FormattedFinalPrice}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="MealItemsListView"
                                  ItemsSource="{Binding MealProductItems}"
                                  ItemTemplate="{StaticResource MealItemTemplate}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  MaxHeight="360" />
                    </StackPanel>

                    <TextBlock Text="{Binding ValidationSummary}"
                               Foreground="IndianRed"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="DarkSlateGray"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Delete"
                                Click="DeleteMealProductButton_Click" />

                        <Button Content="Save Changes"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveMealProductButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>