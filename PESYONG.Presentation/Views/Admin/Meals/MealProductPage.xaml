<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PESYONG.Presentation.Views.Admin.Meals.MealProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:objectmodels="using:PESYONG.Presentation.ViewModels.ObjectModels"
    xmlns:mealentities="using:PESYONG.Domain.Entities.Meals.MealItem"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance objectmodels:MealProductViewModel}">

    <Page.Resources>
        <DataTemplate x:Key="MealProductListTemplate" x:DataType="objectmodels:MealProductViewModel">
            <Grid Padding="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ProductName}"
                               Style="{ThemeResource BaseTextBlockStyle}" />

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind PaxDisplay}"
                               Margin="12,0,0,0"
                               Opacity="0.8"
                               FontStyle="Italic" />
                </Grid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,4,0,0">
                    <TextBlock Text="{x:Bind FormattedFinalPrice}"
                               Opacity="0.75"
                               Style="{ThemeResource BodyTextBlockStyle}" />

                    <TextBlock Text="•"
                               Opacity="0.5"/>

                    <TextBlock Text="{x:Bind ItemCount, Mode=OneWay}"
                               Opacity="0.75"
                               Style="{ThemeResource BodyTextBlockStyle}" />

                    <TextBlock Text="meal(s)"
                               Opacity="0.75"
                               Style="{ThemeResource BodyTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MealCatalogTemplate" x:DataType="mealentities:Meal">
            <StackPanel Padding="8,6">
                <TextBlock Text="{x:Bind MealName}" />
                <TextBlock Text="{x:Bind MealPrice, Mode=OneWay}"
                           FontSize="12"
                           Opacity="0.75" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MealItemTemplate" x:DataType="objectmodels:MealProductItemViewModel">
            <Border Padding="8"
                    Margin="0,4,0,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{x:Bind MealName}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind FormattedUnitPrice}" FontSize="12" Opacity="0.75"/>
                    </StackPanel>

                    <NumberBox Grid.Column="1"
                               Minimum="1"
                               Maximum="100"
                               SmallChange="1"
                               SpinButtonPlacementMode="Inline"
                               ValidationMode="InvalidInputOverwritten"
                               Value="{x:Bind Quantity, Mode=TwoWay}" />

                    <TextBox Grid.Column="2"
                             PlaceholderText="Special request"
                             Text="{x:Bind RequestDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="3"
                            Content="Remove"
                            Click="RemoveMealItemButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: CATERING PACKAGES -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="MealProductsListView"
                      Grid.Row="0"
                      Margin="0,0,0,12"
                      SelectionMode="Single"
                      ItemsSource="{x:Bind MealProductListViewModels, Mode=OneWay}"
                      ItemTemplate="{StaticResource MealProductListTemplate}"
                      SelectionChanged="MealProductsListView_SelectionChanged"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="8"/>

            <Button Grid.Row="1"
                    Content="Add New Catering Package"
                    Click="AddMealProductButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- RIGHT -->
        <Border Grid.Column="2"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <TextBlock Text="Catering Package Configuration"
                               Style="{StaticResource TitleTextBlockStyle}" />

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- IMAGE SECTION -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.RowSpan="2"
                                    Spacing="12">
                            <Border Width="150"
                                    Height="150"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}">
                                <Image x:Name="PackageImageControl"
                                       Source="{Binding ProductImage, Mode=OneWay}"
                                       Width="150"
                                       Height="150"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <Button Content="Change Photo"
                                    Click="PickImageButton_Click"/>
                        </StackPanel>

                        <!-- BASIC INFO -->
                        <Grid Grid.Row="0"
                              Grid.Column="1"
                              ColumnSpacing="12"
                              RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0"
                                     Grid.Column="0"
                                     Header="Catering Package ID"
                                     Text="{Binding MealProductID}"
                                     IsReadOnly="True" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Header="Owner ID"
                                     Text="{Binding OwnerID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="FormTextBox_TextChanged" />

                            <TextBox Grid.Row="1"
                                     Grid.Column="0"
                                     Header="Promo ID"
                                     Text="{Binding PromoID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     TextChanged="FormTextBox_TextChanged" />

                            <NumberBox Grid.Row="1"
                                       Grid.Column="1"
                                       Header="Number of Pax"
                                       Value="{Binding PaxCount, Mode=TwoWay}"
                                       Minimum="0"
                                       SmallChange="1"
                                       LargeChange="5"
                                       SpinButtonPlacementMode="Inline"
                                       ValidationMode="InvalidInputOverwritten"
                                       ValueChanged="PaxCountNumberBox_ValueChanged" />

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Orientation="Vertical"
                                        Spacing="10">

                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <CheckBox Content="Is Catering Package"
                                              IsChecked="{Binding IsCateringPackage, Mode=TwoWay}" />

                                    <CheckBox Content="Is Available"
                                              IsChecked="{Binding IsAvailable, Mode=TwoWay}" />

                                    <CheckBox x:Name="IsCustomizableCheckBox"
                                              Content="Customizable Package"
                                              IsChecked="{Binding IsCustomizable, Mode=TwoWay}"
                                              Checked="IsCustomizableCheckBox_Checked"
                                              Unchecked="IsCustomizableCheckBox_Unchecked" />
                                </StackPanel>

                                <StackPanel x:Name="PreferredViandCountPanel"
                                            Orientation="Horizontal"
                                            Spacing="12"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Preferred Viand Count"
                                               VerticalAlignment="Center" />

                                    <NumberBox x:Name="PreferredViandCountNumberBox"
                                               Width="120"
                                               Minimum="1"
                                               SmallChange="1"
                                               SpinButtonPlacementMode="Inline"
                                               ValidationMode="InvalidInputOverwritten"
                                               Value="{Binding PreferredViandCount, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding PaxDisplay}"
                                       FontStyle="Italic"
                                       Opacity="0.8"
                                       Margin="0,4,0,0" />
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Header="Package Name"
                                 Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />

                        <TextBox Grid.Row="2"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Header="Package Description"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Text="{Binding ProductDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormTextBox_TextChanged" />
                    </Grid>

                    <StackPanel x:Name="FixedMealsPanel" Spacing="8">
                        <TextBlock x:Name="MealsSectionTitle"
                                   Text="Meals to Include in Package"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="MealSelectorComboBox"
                                      Grid.Column="0"
                                      Header="Select Meal to Add"
                                      ItemsSource="{Binding AvailableMeals}"
                                      SelectedItem="{Binding SelectedMealForAdd, Mode=TwoWay}"
                                      DisplayMemberPath="MealName" />

                            <Button x:Name="AddMealButton"
                                    Grid.Column="1"
                                    Content="Add Meal"
                                    VerticalAlignment="Bottom"
                                    Click="AddMealItemButton_Click" />
                        </Grid>

                        <TextBlock x:Name="CustomizableHintText"
                                   Visibility="Collapsed"
                                   Foreground="DarkOrange"
                                   TextWrapping="Wrap"
                                   Text="This package is customizable. Customers will choose their preferred viands, so fixed meals are not required." />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="IncludedMealsTitle"
                                       Grid.Column="0"
                                       Text="Meals Included in This Package"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Spacing="2">
                                <TextBlock Text="{Binding FormattedFinalPrice}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="MealItemsListView"
                                  ItemsSource="{Binding MealProductItems}"
                                  ItemTemplate="{StaticResource MealItemTemplate}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  MaxHeight="360" />
                    </StackPanel>

                    <TextBlock Text="{Binding ValidationSummary}"
                               Foreground="IndianRed"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="DarkSlateGray"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Delete"
                                Click="DeleteMealProductButton_Click" />

                        <Button Content="Save Changes"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveMealProductButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>