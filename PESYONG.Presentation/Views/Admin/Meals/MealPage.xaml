<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PESYONG.Presentation.Views.Admin.Meals.MealPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:objectmodels="using:PESYONG.ApplicationLogic.ViewModels.ObjectModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    d:DataContext="{d:DesignInstance objectmodels:MealViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="PageGap">16</x:Double>
        <x:Double x:Key="SectionGap">20</x:Double>
        <x:Double x:Key="FieldGap">12</x:Double>
        <x:Double x:Key="CardCornerRadius">8</x:Double>
        <x:Double x:Key="ImageBoxSize">150</x:Double>
        <x:Double x:Key="CompactBreakPoint">720</x:Double>

        <Style x:Key="FormSectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource BodyLargeStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>

        <Style x:Key="FormCaptionStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="StandardTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>

        <Style x:Key="StandardNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="SpinButtonPlacementMode" Value="Inline"/>
            <Setter Property="ValidationMode" Value="InvalidInputOverwritten"/>
        </Style>

        <Style x:Key="StandardComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>

        <DataTemplate x:Key="AdminMealListViewTemplate" x:DataType="objectmodels:MealViewModel">
            <Grid Padding="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind MealName}"
                           x:Phase="1"
                           Style="{ThemeResource BaseTextBlockStyle}"/>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind DeliveryType}"
                           x:Phase="2"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Opacity="0.75"
                           Margin="0,2,0,0"/>
            </Grid>
        </DataTemplate>

        <FontIconSource x:Key="TokenQueryIconSource" Glyph="&#xE721;" FontSize="12"/>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="MealsListView"
                      Grid.Row="0"
                      Margin="0,0,0,12"
                      SelectionMode="Single"
                      ItemsSource="{x:Bind MealListViewModels, Mode=OneWay}"
                      ItemTemplate="{StaticResource AdminMealListViewTemplate}"
                      SelectionChanged="ListView_SelectionChanged" 
                      Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="8"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12">
                <Grid>
                    <Button x:Name="QueryPopupToggleButton"
                            Content="Filter meal list"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ShowQueryPopupButton_Click"/>

                    <Popup x:Name="QueryPopup"
                           VerticalOffset="-170"
                           HorizontalOffset="0"
                           IsLightDismissEnabled="True">
                        <Border Width="220"
                                MinHeight="160"
                                Padding="20"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Simple Popup"
                                           FontSize="16"
                                           HorizontalAlignment="Center"/>
                                <Button Content="Close"
                                        Click="CloseQueryPopupButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Button x:Name="AddMealButton"
                        Content="Add New Meal"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="AddMealButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT COLUMN -->
        <Border Grid.Column="2"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Meal Configuration"
                                   Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="Manage product information without changing the current functional flow."
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>

                    <StackPanel Spacing="20">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ResponsiveStates">
                                <VisualState x:Name="WideState"/>
                                <VisualState x:Name="CompactState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="HeaderResponsiveGrid.ColumnDefinitions[0].Width" Value="*"/>
                                        <Setter Target="HeaderResponsiveGrid.ColumnDefinitions[1].Width" Value="0"/>
                                        <Setter Target="HeaderResponsiveGrid.ColumnDefinitions[2].Width" Value="0"/>

                                        <Setter Target="PricingStockGrid.ColumnDefinitions[0].Width" Value="*"/>
                                        <Setter Target="PricingStockGrid.ColumnDefinitions[1].Width" Value="0"/>
                                        <Setter Target="PricingStockGrid.ColumnDefinitions[2].Width" Value="0"/>

                                        <Setter Target="IdentityGrid.ColumnDefinitions[0].Width" Value="*"/>
                                        <Setter Target="IdentityGrid.ColumnDefinitions[1].Width" Value="0"/>
                                        <Setter Target="IdentityGrid.ColumnDefinitions[2].Width" Value="0"/>

                                        <Setter Target="InventoryGrid.ColumnDefinitions[0].Width" Value="*"/>
                                        <Setter Target="InventoryGrid.ColumnDefinitions[1].Width" Value="0"/>
                                        <Setter Target="InventoryGrid.ColumnDefinitions[2].Width" Value="0"/>

                                        <Setter Target="MealDetailsGrid.ColumnDefinitions[0].Width" Value="*"/>
                                        <Setter Target="MealDetailsGrid.ColumnDefinitions[1].Width" Value="0"/>
                                        <Setter Target="MealDetailsGrid.ColumnDefinitions[2].Width" Value="0"/>

                                        <Setter Target="HeaderImagePanel.(Grid.Column)" Value="0"/>
                                        <Setter Target="HeaderImagePanel.(Grid.Row)" Value="0"/>
                                        <Setter Target="HeaderInfoPanel.(Grid.Column)" Value="0"/>
                                        <Setter Target="HeaderInfoPanel.(Grid.Row)" Value="1"/>

                                        <Setter Target="DescriptionBox.(Grid.ColumnSpan)" Value="1"/>
                                        <Setter Target="TagsPanel.(Grid.ColumnSpan)" Value="1"/>

                                        <Setter Target="FormattedPriceText.(Grid.Row)" Value="1"/>
                                        <Setter Target="FormattedPriceText.(Grid.Column)" Value="0"/>
                                        <Setter Target="FormattedPriceText.Margin" Value="0,4,0,0"/>
                                        <Setter Target="FormattedPriceText.VerticalAlignment" Value="Top"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="HeaderResponsiveGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="HeaderImagePanel"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="12">
                                <Border Width="150"
                                        Height="150"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}">
                                    <Image x:Name="MealImageControl"
                                           Source="{Binding MealImage, Mode=OneWay}"
                                           Width="120"
                                           Height="120"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <Button x:Name="ModifyImageButton"
                                        Content="Change Photo"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Foreground="White"
                                        Click="PickImageButton_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="HeaderInfoPanel"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Spacing="8">
                                <TextBlock Text="Catering Meal"
                                           Style="{StaticResource TitleTextBlockStyle}"/>

                                <Grid x:Name="IdentityGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Row="0"
                                             Grid.Column="0"
                                             Header="Meal ID"
                                             Text="{Binding MealID}"
                                             IsReadOnly="True"
                                             Style="{StaticResource StandardTextBoxStyle}"/>

                                    <TextBox Grid.Row="0"
                                             Grid.Column="2"
                                             Header="Creator ID"
                                             Text="{Binding OperatorID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             TextChanged="TextBox_TextChanged"/>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Margin="0,8,0,0"
                                                Spacing="4">
                                        <CalendarDatePicker Header="Creation Date"
                                                            Date="{Binding CreationDate, Mode=TwoWay}"/>
                                        <TextBlock Text="{Binding RelativeCreationTime, FallbackValue='Recently created'}"
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   FontStyle="Italic"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Meal Details"
                                       Style="{StaticResource FormSectionTitleStyle}"/>
                            <TextBlock Text="Manage the details presented in customer kiosk view."
                                       Style="{StaticResource FormCaptionStyle}"/>
                        </StackPanel>

                        <Grid x:Name="MealDetailsGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="3"
                                     Header="Meal Title"
                                     Text="{Binding MealName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Enter meal name"
                                     Style="{StaticResource StandardTextBoxStyle}"
                                     TextChanged="TextBox_TextChanged"/>

                            <TextBox x:Name="DescriptionBox"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="3"
                                     Header="Description"
                                     Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Enter meal description"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="120"
                                     Style="{StaticResource StandardTextBoxStyle}"
                                     TextChanged="TextBox_TextChanged"/>

                            <Grid x:Name="PricingStockGrid"
                                  Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Row="0"
                                         Grid.Column="0"
                                         Header="Price"
                                         Text="{Binding MealPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource StandardTextBoxStyle}"
                                         VerticalAlignment="Bottom"
                                         TextChanged="TextBox_TextChanged">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>

                                <TextBlock x:Name="FormattedPriceText"
                                           Grid.Row="0"
                                           Grid.Column="2"
                                           Text="{Binding FormattedPrice, FallbackValue='PHP 0.00'}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="DarkGreen"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                            </Grid>

                            <ComboBox Grid.Row="3"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Header="Delivery Type"
                                      ItemsSource="{x:Bind DeliveryTypes, Mode=OneWay}"
                                      SelectedItem="{Binding DeliveryType, Mode=TwoWay}"
                                      Style="{StaticResource StandardComboBoxStyle}"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Stock Management"
                                       Style="{StaticResource FormSectionTitleStyle}"/>
                            <TextBlock Text="Manage the inventory of meals for the kiosk catalogue."
                                       Style="{StaticResource FormCaptionStyle}"/>
                        </StackPanel>

                        <Grid x:Name="InventoryGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <NumberBox Grid.Column="0"
                                       Header="Stock Quantity"
                                       Value="{Binding StockQuantity, Mode=TwoWay}"
                                       Width="Auto"
                                       Minimum="0"
                                       SmallChange="1"
                                       LargeChange="10"
                                       Style="{StaticResource StandardNumberBoxStyle}"
                                       ValueChanged="NumberBox_ValueChanged"/>

                            <NumberBox Grid.Column="2"
                                       Header="Min Order"
                                       Value="{Binding MinOrderQuantity, Mode=TwoWay}"
                                       Width="Auto"
                                       Minimum="1"
                                       SmallChange="1"
                                       LargeChange="5"
                                       Style="{StaticResource StandardNumberBoxStyle}"
                                       ValueChanged="NumberBox_ValueChanged"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Meal Tags"
                                       Style="{StaticResource FormSectionTitleStyle}"/>
                            <TextBlock Text="Add and manage tags for this meal."
                                       Style="{StaticResource FormCaptionStyle}"/>
                        </StackPanel>

                        <StackPanel x:Name="TagsPanel"
                                    Spacing="8">
                            <controls:TokenizingTextBox x:Name="TokenBox"
                                                        ItemsSource="{Binding MealTags, Mode=TwoWay}"
                                                        SuggestedItemsSource="{Binding AvailableTags, Mode=OneWay}"
                                                        TokenDelimiter=","
                                                        MaximumTokens="5"
                                                        PlaceholderText="Add tags"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="200"
                                                        MaxWidth="800">
                                <controls:TokenizingTextBox.Header>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run Text="Manage meal tags with a limit of " />
                                        <Run Text="{Binding MaximumTokens, ElementName=TokenBox, Mode=OneWay}"
                                             FontWeight="SemiBold" />
                                        <Run Text=" tokens." />
                                    </TextBlock>
                                </controls:TokenizingTextBox.Header>

                                <controls:TokenizingTextBox.SuggestedItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </controls:TokenizingTextBox.SuggestedItemTemplate>

                                <controls:TokenizingTextBox.TokenItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </controls:TokenizingTextBox.TokenItemTemplate>
                            </controls:TokenizingTextBox>
                        </StackPanel>

                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ValidationSummary}"
                                       Foreground="IndianRed"
                                       TextWrapping="WrapWholeWords"/>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="DarkSlateGray"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Margin="0,8,0,0">
                            <Button x:Name="DeleteButton"
                                    Content="Delete"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Foreground="White"
                                    Click="DeleteButton_Click"/>

                            <Button x:Name="SaveButton"
                                    Content="Save Changes"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Foreground="White"
                                    Click="SaveButton_Click"/>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>