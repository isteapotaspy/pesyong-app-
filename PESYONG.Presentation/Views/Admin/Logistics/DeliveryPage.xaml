<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PESYONG.Presentation.Views.Admin.Logistics.DeliveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:objectmodels="using:PESYONG.Presentation.ViewModels.ObjectModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance objectmodels:DeliveryViewModel}">

    <Page.Resources>
        <DataTemplate x:Key="DeliveryListTemplate" x:DataType="objectmodels:DeliveryViewModel">
            <Grid Padding="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind DisplayName}"
                           Style="{ThemeResource BaseTextBlockStyle}" />

                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Text="{x:Bind DeliveryAddress}"
                           Opacity="0.75"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DeliveryUpdatePreviewTemplate" x:DataType="objectmodels:DeliveryUpdateViewModel">
            <Border Padding="8"
                    Margin="0,4,0,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Bind DisplayName}"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind UpdateDescription}"
                               FontSize="12"
                               Opacity="0.75"
                               TextWrapping="WrapWholeWords"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="DeliveriesListView"
                      Grid.Row="0"
                      Margin="0,0,0,12"
                      SelectionMode="Single"
                      ItemsSource="{x:Bind DeliveryListViewModels, Mode=OneWay}"
                      ItemTemplate="{StaticResource DeliveryListTemplate}"
                      SelectionChanged="ListView_SelectionChanged"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="8" />

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1"
                        Spacing="8">
                <Button Content="Add New Delivery"
                        Click="AddDeliveryButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />

                <Button Content="Refresh Deliveries"
                        Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <!-- RIGHT -->
        <Border Grid.Column="2"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <TextBlock Text="Delivery Configuration"
                               Style="{StaticResource TitleTextBlockStyle}" />

                    <InfoBar IsOpen="{Binding HasStatusMessage, Mode=OneWay}"
                             Severity="Informational"
                             Message="{Binding StatusMessage}" />

                    <!-- Core Details -->
                    <Grid ColumnSpacing="12"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Header="Delivery ID"
                                 Text="{Binding DeliveryID, Mode=OneWay}"
                                 IsReadOnly="True" />

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Header="Order ID"
                                 Text="{Binding OrderIDText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 Header="Delivery Personnel ID"
                                 Text="{Binding DeliveryPersonnelIDText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Header="Status"
                                  ItemsSource="{x:Bind DeliveryStatuses, Mode=OneWay}"
                                  SelectedItem="{Binding Status, Mode=TwoWay}"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  IsEnabled="{Binding AreEditableFieldsEnabled, Mode=OneWay}" />

                        <TextBox Grid.Row="2"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Header="Delivery Address"
                                 Text="{Binding DeliveryAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />
                    </Grid>

                    <!-- Shipping -->
                    <Grid ColumnSpacing="12"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Header="Tracking Number"
                                 Text="{Binding TrackingNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <NumberBox Grid.Row="0"
                                   Grid.Column="1"
                                   Header="Shipping Cost"
                                   Value="{Binding ShippingCost, Mode=TwoWay}"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   ValidationMode="InvalidInputOverwritten"
                                   ValueChanged="NumberBox_ValueChanged"
                                   IsEnabled="{Binding AreEditableFieldsEnabled, Mode=OneWay}" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 Header="Shipping Method"
                                 Text="{Binding ShippingMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Header="Carrier Name"
                                 Text="{Binding CarrierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />
                    </Grid>

                    <!-- Dates and Receipt -->
                    <Grid ColumnSpacing="12"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Header="Created Date"
                                 Text="{Binding CreatedDateDisplay, Mode=OneWay}"
                                 IsReadOnly="True" />

                        <CheckBox Grid.Row="0"
                                  Grid.Column="1"
                                  Content="Signature Required"
                                  IsChecked="{Binding SignatureRequired, Mode=TwoWay}"
                                  IsEnabled="{Binding AreEditableFieldsEnabled, Mode=OneWay}" />

                        <CalendarDatePicker Grid.Row="1"
                                            Grid.Column="0"
                                            Header="Estimated Delivery"
                                            Date="{Binding EstimatedDeliveryDateUi, Mode=TwoWay}"
                                            IsEnabled="{Binding AreEditableFieldsEnabled, Mode=OneWay}" />

                        <CalendarDatePicker Grid.Row="1"
                                            Grid.Column="1"
                                            Header="Actual Delivery"
                                            Date="{Binding ActualDeliveryDateUi, Mode=TwoWay}"
                                            IsEnabled="{Binding AreEditableFieldsEnabled, Mode=OneWay}" />

                        <TextBox Grid.Row="2"
                                 Grid.Column="0"
                                 Header="Received By"
                                 Text="{Binding ReceivedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <CalendarDatePicker Grid.Row="2"
                                            Grid.Column="1"
                                            Header="Received At"
                                            Date="{Binding ReceivedAtUi, Mode=TwoWay}"
                                            IsEnabled="{Binding AreEditableFieldsEnabled, Mode=OneWay}" />
                    </Grid>

                    <!-- Location -->
                    <Grid ColumnSpacing="12"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Header="Current Location"
                                 Text="{Binding CurrentLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <CalendarDatePicker Grid.Row="0"
                                            Grid.Column="1"
                                            Header="Last Location Update"
                                            Date="{Binding LastLocationUpdateUi, Mode=TwoWay}"
                                            IsEnabled="{Binding AreEditableFieldsEnabled, Mode=OneWay}" />
                    </Grid>

                    <!-- Notes -->
                    <Grid ColumnSpacing="12"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Header="Special Instructions"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 Text="{Binding SpecialInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <TextBox Grid.Row="1"
                                 Header="Delivery Notes"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Text="{Binding DeliveryNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />

                        <TextBox Grid.Row="2"
                                 Header="Proof Of Delivery"
                                 Text="{Binding ProofOfDelivery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="FormFieldChanged"
                                 IsReadOnly="{Binding IsReadOnlyComputedFields, Mode=OneWay}" />
                    </Grid>

                    <!-- Updates -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Delivery Updates"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <Button Grid.Column="1"
                                    Content="Add Update"
                                    Click="AddDeliveryUpdateButton_Click" />
                        </Grid>

                        <ListView x:Name="DeliveryUpdatesListView"
                                  ItemsSource="{Binding DeliveryUpdates}"
                                  ItemTemplate="{StaticResource DeliveryUpdatePreviewTemplate}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="False"
                                  MaxHeight="320" />
                    </StackPanel>

                    <!-- Validation -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [OrderIDText], FallbackValue=''}"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding [DeliveryAddress], FallbackValue=''}"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding [TrackingNumber], FallbackValue=''}"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding [ShippingCost], FallbackValue=''}"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding [Status], FallbackValue=''}"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="DarkSlateGray"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Delete"
                                Click="DeleteButton_Click" />

                        <Button Content="Save Changes"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>